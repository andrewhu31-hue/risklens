DATABASE_URL=sqlite:///./risklens.db
ANTHROPIC_API_KEY=your_key_here
# Comma-separated list of origins allowed to call this API (no wildcard).
CORS_ORIGINS=http://localhost:5173
# Secret used to sign login tokens (JWTs) — set this to a long random string.
# Anyone who has it can forge valid logins, so never commit a real value.
JWT_SECRET=change_me_to_a_random_string
